---
import { data, href } from '../lib/data'

interface Props {
  title: string
  description?: string
}
const { title, description } = Astro.props
const path = Astro.url.pathname
const nav = [
  { href: '/', label: 'Leaderboard' },
  { href: '/results/', label: 'All results' },
  { href: '/models/', label: 'Models' },
  { href: '/gallery/', label: 'Galleries' },
  { href: '/cases/', label: 'Cases' },
  { href: '/corpus/', label: 'Corpus' },
  { href: '/speed/', label: 'Speed & memory' },
  { href: '/runs/', label: 'Runs' },
]
const active = (h: string) => (h === '/' ? path === href('/') || path === '/' : path.startsWith(href(h)))
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Small model evals{data.scope === 'private' ? ' (private)' : ''}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="top">
      <a class="brand" href={href('/')}>Small model evals</a>
      {data.scope === 'private' && <span class="private" title="Private suites under private/; never published">private · local only</span>}
      <nav>
        {nav.map((n) => <a href={href(n.href)} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <span class="generated">Data from {data.runs.length} runs · exported {data.generated_at.slice(0, 16).replace('T', ' ')} UTC</span>
    </header>
    <main>
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      <slot />
    </main>
    <script>
      import '../scripts/table.ts'
      import '../scripts/reveal.ts'
    </script>
  </body>
</html>

<style is:global>
  .shot-frame {
    position: relative;
    display: block;
  }
  /* A covered image has no src (components/Shot.astro), so the frame
     gives it a size and a dark ground. */
  .shot-frame.censored {
    overflow: hidden;
    min-height: 190px;
    background: #2b2b2e;
    border-radius: 6px;
  }
  .shot-frame.censored img {
    visibility: hidden;
  }
  .shot-frame.censored a {
    pointer-events: none;
  }
  .shot-frame.censored .overlay {
    display: none;
  }
  .shot-frame .reveal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 0;
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .shot-frame .reveal-note {
    font-size: 0.8rem;
    opacity: 0.85;
  }
  .shot-frame .reveal-cta {
    font-weight: 600;
    padding: 0.3rem 0.9rem;
    border: 1px solid #fff;
    border-radius: 999px;
  }
  .shot-frame:not(.censored) .reveal {
    display: none;
  }
  :root {
    --bg: #fbfbfa;
    --panel: #ffffff;
    --text: #1d1d1f;
    --muted: #6b6b70;
    --line: #e4e4e2;
    --accent: #2f5bd3;
    --good: #1f7a4d;
    --good-bg: #e2f3ea;
    --ok-bg: #eef5e0;
    --warn: #8a5a00;
    --warn-bg: #fbf0d9;
    --bad: #b3261e;
    --bad-bg: #fbe4e2;
    --code-bg: #f3f3f1;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141416;
      --panel: #1c1c1f;
      --text: #ececee;
      --muted: #9a9aa0;
      --line: #2e2e33;
      --accent: #8aa8ff;
      --good: #6fd19c;
      --good-bg: #173426;
      --ok-bg: #22301a;
      --warn: #e9b85c;
      --warn-bg: #3a2e14;
      --bad: #ff8a80;
      --bad-bg: #3d1d1b;
      --code-bg: #232327;
      color-scheme: dark;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .top {
    position: sticky; top: 0; z-index: 2;
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 20px;
    padding: 10px 24px; background: var(--panel); border-bottom: 1px solid var(--line);
  }
  .brand { font-weight: 650; color: var(--text); }
  .top nav { display: flex; gap: 16px; flex-wrap: wrap; }
  .top nav a { color: var(--muted); }
  .top nav a[aria-current='page'] { color: var(--text); font-weight: 600; }
  .generated { margin-left: auto; color: var(--muted); font-size: 12px; }
  main { max-width: 1280px; margin: 0 auto; padding: 24px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 18px; margin: 32px 0 8px; }
  .lede { color: var(--muted); margin: 0 0 16px; max-width: 80ch; }
  .note { color: var(--muted); font-size: 13px; max-width: 90ch; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 12px 0; }
  .controls input, .controls select {
    font: inherit; padding: 6px 10px; border: 1px solid var(--line); border-radius: 6px;
    background: var(--panel); color: var(--text);
  }
  .controls input[type='search'] { min-width: 260px; flex: 1; max-width: 420px; }
  .count { color: var(--muted); font-size: 13px; margin-left: auto; }
  .scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
  table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: 7px 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); font-weight: 600; white-space: nowrap; background: var(--panel); position: sticky; top: 0; }
  th[data-sort] { cursor: pointer; user-select: none; }
  th[data-sort]::after { content: ' ↕'; opacity: 0.35; }
  th[data-dir='asc']::after { content: ' ↑'; opacity: 1; }
  th[data-dir='desc']::after { content: ' ↓'; opacity: 1; }
  td.num, th.num { text-align: right; }
  tbody tr:last-child td { border-bottom: 0; }
  tr[data-toggle] { cursor: pointer; }
  tr[data-toggle]:hover td { background: var(--code-bg); }
  tr.detail td { background: var(--code-bg); }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .pill.pass { background: var(--good-bg); color: var(--good); }
  .pill.fail { background: var(--bad-bg); color: var(--bad); }
  .pill.stale { background: var(--warn-bg); color: var(--warn); }
  .heat { font-weight: 600; text-align: center; }
  .heat.good { background: var(--good-bg); color: var(--good); }
  .heat.ok { background: var(--ok-bg); color: var(--good); }
  .heat.warn { background: var(--warn-bg); color: var(--warn); }
  .heat.bad { background: var(--bad-bg); color: var(--bad); }
  .heat small { display: block; font-weight: 400; color: var(--muted); font-size: 11px; }
  .heat a { color: inherit; }
  pre {
    margin: 6px 0 0; padding: 10px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px;
    white-space: pre-wrap; word-break: break-word; font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
    max-height: 360px; overflow: auto;
  }
  code { font: 12.5px ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--code-bg); padding: 1px 4px; border-radius: 4px; }
  .detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .detail-grid h4 { margin: 0; font-size: 12px; text-transform: uppercase; color: var(--muted); }
  .shot { max-width: 100%; border: 1px solid var(--line); border-radius: 6px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin: 12px 0; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }
  .card .k { color: var(--muted); font-size: 12px; text-transform: uppercase; }
  .card .v { font-size: 20px; font-weight: 650; }
  .muted { color: var(--muted); }
  @media (max-width: 640px) {
    main { padding: 16px; }
    .generated { margin-left: 0; }
  }
  .private {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: #b42318;
    color: #fff;
  }
</style>
