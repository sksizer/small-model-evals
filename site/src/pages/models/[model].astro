---
import Base from '../../layouts/Base.astro'
import { buildOf, data, fmt, fmtDisk, fmtParams, fmtTime, href, modelSlug, pct, qualitySuites, shortUrl, tone } from '../../lib/data'

export function getStaticPaths() {
  return data.models.map((model) => ({ params: { model: modelSlug(model.label) }, props: { model } }))
}

const { model } = Astro.props as { model: (typeof data.models)[number] }
const cells = data.cells.filter((c) => c.model === model.label)
const perf = data.perf.filter((p) => p.model === model.label)
const failures = data.results.filter((r) => r.model === model.label && !r.pass)
const build = buildOf(model.label)
const cat = model.catalog
const inproc = data.inproc.filter((p) => p.model === model.label)
// Only the suites that list this model as a provider; the others cannot run it.
const suites = qualitySuites.filter((s) => s.models.includes(model.label))
const params = build?.parameter_count ?? cat?.parameters
const src = model.source
const history = data.history.filter((h) => h.model === model.label).sort((a, b) => b.run.localeCompare(a.run))
---

<Base title={model.label} description={model.runtime === 'ollama' ? `Ollama tag ${model.tag}, build ${model.digest}.` : model.runtime === 'local' ? `Local code (${model.tag}), version ${src.revision}.` : `Hugging Face ${model.tag}, revision ${src.revision?.slice(0, 7)}.`}>
  {
    cat && (
      <>
        <h2>About this model</h2>
        <div class="scroll facts">
          <table>
            <tbody>
              <tr>
                <th>Get it</th>
                <td>
                  <a href={cat.url}>{shortUrl(cat.url)}</a>
                  {cat.source_url && (
                    <>
                      {' · '}source <a href={cat.source_url}>{shortUrl(cat.source_url)}</a>
                    </>
                  )}
                </td>
              </tr>
              <tr>
                <th>Kind</th>
                <td>
                  {cat.kind} · takes {cat.inputs.join(', ')} · returns {cat.outputs.join(', ')}
                </td>
              </tr>
              <tr>
                <th>Publisher</th>
                <td>{cat.publisher}</td>
              </tr>
              <tr>
                <th>Licence</th>
                <td>{cat.licence_url ? <a href={cat.licence_url}>{cat.licence}</a> : cat.licence}</td>
              </tr>
              {cat.parameters !== undefined && (
                <tr>
                  <th>Parameters</th>
                  <td>
                    {fmtParams(cat.parameters)} <span class="muted">({cat.parameters.toLocaleString('en-US')})</span>
                    {cat.parameters_note && <div class="muted">{cat.parameters_note}</div>}
                  </td>
                </tr>
              )}
              {cat.architecture && (
                <tr>
                  <th>Architecture</th>
                  <td>{cat.architecture}</td>
                </tr>
              )}
              {cat.base_model && (
                <tr>
                  <th>Derived from</th>
                  <td>
                    <a href={`https://huggingface.co/${cat.base_model}`}>{cat.base_model}</a>
                  </td>
                </tr>
              )}
              {cat.disk_gb !== undefined && (
                <tr>
                  <th>Download</th>
                  <td>{fmtDisk(cat.disk_gb)} as run</td>
                </tr>
              )}
              {cat.languages && (
                <tr>
                  <th>Languages</th>
                  <td>{cat.languages}</td>
                </tr>
              )}
              {cat.paper && (
                <tr>
                  <th>Paper</th>
                  <td>
                    <a href={cat.paper}>{shortUrl(cat.paper)}</a>
                  </td>
                </tr>
              )}
              {model.released && (
                <tr>
                  <th>Released</th>
                  <td>
                    {model.released}
                    {model.released_approx && <span class="muted"> (from memory, unchecked)</span>}
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
        <p class="note">{cat.notes}</p>
      </>
    )
  }
  {
    build && (
      <div class="cards">
        <div class="card">
          <div class="k">Engine</div>
          <div class="v" style={build.engine.length > 12 ? 'font-size:15px' : undefined}>{build.engine === 'default' ? 'llama.cpp' : build.engine.length > 12 ? build.engine : build.engine.toUpperCase()}</div>
          <div class="muted">{build.format}</div>
        </div>
        <div class="card">
          <div class="k">Weights</div>
          <div class="v">{build.quantization}</div>
          <div class="muted">
            {params !== undefined && params !== null ? `${fmtParams(params)} parameters` : 'parameters unknown'}{build.family && ` · ${build.family}`}
          </div>
        </div>
        <div class="card">
          <div class="k">Max context</div>
          <div class="v">{build.context_length ? `${Math.round(build.context_length / 1024)}K` : '—'}</div>
          <div class="muted">{build.capabilities.join(', ')}</div>
        </div>
        {model.runtime === 'ollama' ? (
          <div class="card">
            <div class="k">Default sampling</div>
            <div class="muted">
              {Object.entries(build.default_parameters)
                .map(([k, v]) => `${k} ${v}`)
                .join(' · ') || '—'}
            </div>
          </div>
        ) : (
          <div class="card">
            <div class="k">{model.runtime === 'local' ? 'Code version' : 'Pinned revision'}</div>
            <div class="v">
              {src.revision_url ? <a href={src.revision_url} title={src.revision ?? undefined}><code>{src.revision?.slice(0, 7)}</code></a> : <code>{src.revision ?? '—'}</code>}
            </div>
            <div class="muted">{model.runtime === 'local' ? 'bumped when the output could change' : 'a commit on Hugging Face'}</div>
          </div>
        )}
      </div>
    )
  }
  <div class="cards">
    {
      suites.map((s) => {
        const c = cells.find((x) => x.suite === s.id)
        if (!c)
          return (
            <div class="card">
              <div class="k">{s.id}</div>
              <div class="v muted">not run</div>
            </div>
          )
        const rate = pct(c.passed, c.total)
        return (
          <a class={`card heat ${tone(rate)}`} href={href(`/results/?suite=${s.id}&model=${encodeURIComponent(model.label)}`)}>
            <div class="k">{s.id}</div>
            <div class="v">{rate}%</div>
            <div>
              {c.passed}/{c.total} · {fmtTime(c.time_ms, c.time_per)}{c.stale && ' · stale'}
            </div>
          </a>
        )
      })
    }
  </div>

  <h2>Speed and memory</h2>
  {
    perf.length === 0 && inproc.length === 0 ? (
      <p class="muted">No speed runs yet.</p>
    ) : null
  }
  {
    inproc.length > 0 && (
      <>
        <div class="scroll">
          <table data-table id="model-inproc">
            <thead>
              <tr>
                <th data-sort="text">Suite</th>
                <th data-sort="num" class="num">Per image</th>
                <th data-sort="num" class="num">Load</th>
                <th data-sort="num" class="num">Memory</th>
              </tr>
            </thead>
            <tbody>
              {inproc.map((p) => (
                <tr>
                  <td>{p.suite}</td>
                  <td class="num" data-value={p.per_image_ms ?? -1}>{fmtTime(p.per_image_ms)}</td>
                  <td class="num" data-value={p.load_ms ?? -1}>{fmtTime(p.load_ms)}</td>
                  <td class="num" data-value={p.mem_mb ?? -1}>
                    {p.mem_mb === null ? '—' : `${Math.round(p.mem_mb).toLocaleString('en-US')} MB`} <span class="muted">{p.mem_kind}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">Runs in-process, not in Ollama. <strong>rss</strong> is the whole process's resident memory, so an upper bound for the model; <strong>peak</strong> is the editor's own peak.</p>
      </>
    )
  }
  {
    perf.length > 0 && (
      <div class="scroll">
        <table data-table id="model-speed">
          <thead>
            <tr>
              <th data-sort="text">Case</th>
              <th data-sort="num" class="num">Output tok/s</th>
              <th data-sort="num" class="num">Prompt tok/s</th>
              <th data-sort="num" class="num">Loaded GB</th>
              <th data-sort="num" class="num">Cold load s</th>
            </tr>
          </thead>
          <tbody>
            {perf.map((p) => (
              <tr>
                <td>
                  <code>{p.case}</code>
                </td>
                <td class="num" data-value={p.decode_tps ?? p.embeds_per_s ?? -1}>
                  {p.embeds_per_s !== null ? `${fmt(p.embeds_per_s, 0)} embeds/s` : fmt(p.decode_tps)}
                </td>
                <td class="num" data-value={p.prompt_tps ?? -1}>
                  {p.prompt_cached ? <span class="muted">cached</span> : fmt(p.prompt_tps, 0)}
                </td>
                <td class="num" data-value={p.loaded_gb ?? -1}>{fmt(p.loaded_gb, 2)}</td>
                <td class="num" data-value={p.load_s ?? -1}>{fmt(p.load_s)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Failed cases ({failures.length})</h2>
  {
    failures.length === 0 ? (
      <p class="muted">None in the latest runs.</p>
    ) : (
      <div class="scroll">
        <table data-table id="model-fails">
          <thead>
            <tr>
              <th data-sort="text">Suite</th>
              <th data-sort="text">Case</th>
              <th data-sort="num" class="num">Score</th>
              <th>Why</th>
            </tr>
          </thead>
          <tbody>
            {failures.map((f) => (
              <tr>
                <td>{f.suite}</td>
                <td>
                  <a href={href(`/results/?suite=${f.suite}&model=${encodeURIComponent(model.label)}&q=${encodeURIComponent(f.case)}`)}>
                    <code>{f.case}</code>
                  </a>
                </td>
                <td class="num" data-value={f.score}>
                  {f.score.toFixed(2)}
                </td>
                <td class="muted">{f.error || f.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>History</h2>
  <p class="note">Pass count per run. A changed suite fingerprint means the cases changed between runs, so the counts are not directly comparable.</p>
  <div class="scroll">
    <table data-table id="model-history">
      <thead>
        <tr>
          <th data-sort="text">Run</th>
          <th data-sort="text">Suite</th>
          <th data-sort="num" class="num">Passed</th>
          <th>Fingerprint</th>
          <th>Machine</th>
        </tr>
      </thead>
      <tbody>
        {
          history.map((h) => (
            <tr>
              <td>
                <code>{h.run}</code>
              </td>
              <td>{h.suite}</td>
              <td class="num" data-value={pct(h.passed, h.total)}>
                {h.passed}/{h.total}
              </td>
              <td>
                <code>{h.suite_fp}</code>
              </td>
              <td>{h.machine}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>

<style>
  .facts th {
    width: 9rem;
    position: static;
    white-space: nowrap;
  }
  .facts td {
    overflow-wrap: anywhere;
  }
</style>
