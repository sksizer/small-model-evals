---
import Base from '../../layouts/Base.astro'
import Compare from '../../components/Compare.astro'
import Boxes from '../../components/Boxes.astro'
import Shot from '../../components/Shot.astro'
import SimilarityTable from '../../components/SimilarityTable.astro'
import { data, describeExpected, href, imageSuites, isEdit, isRegions, isSimilarity, modelSlug, show, type Suite } from '../../lib/data'

export function getStaticPaths() {
  return imageSuites.map((suite) => ({ params: { suite: suite.id }, props: { suite } }))
}

// Each image beside what every model read from it: the expected strings or
// tags as chips, green when the model's reply has them, struck through when
// not; for the regions suite, the expected boxes on the image and each
// model's boxes on its own copy. The case's own expectations show above, so a
// case with no results yet can be reviewed here too.
const { suite } = Astro.props as { suite: Suite }
const results = data.results.filter((r) => r.suite === suite.id)
const models = [...new Set(results.map((r) => r.model))].sort()
const regions = suite.cases.some((c) => isRegions(c.expected))
const edits = suite.cases.some((c) => isEdit(c.expected))
const similarity = suite.cases.some((c) => isSimilarity(c.expected))
---

<Base
  title={`Gallery: ${suite.id}`}
  description={
    similarity
      ? 'Each query photo beside every model\'s five most alike candidates with the model\'s score. Green outline: a copy, an edit or the same scene (what should match). Amber: the same kind of thing. Red: unrelated. The table gives recall per level for each model.'
      : edits
      ? 'Each original (the dashed box is the only area the edit may change) beside every model\'s edited image, with the instruction. Under each edit, the judge\'s yes/no per question: green met, red not met, and how much the image outside the box differs from the original. Open a reply to read it in full.'
      : regions
      ? 'Each image with its expected boxes (dashed blue), then every model\'s boxes on its own copy: green matched an expected box, red is a box that matches nothing, dashed grey is an expected box the model missed. Open a reply to read it in full.'
      : 'Each image beside what every model read from it. Green chips were found in the reply; struck-through ones were missed; solid red ones are wrong tags the model gave. Open a reply to read it in full.'
  }
>
  {similarity && <SimilarityTable results={results} />}
  <div class="controls">
    <select id="g-model" aria-label="Model">
      <option value="">All models</option>
      {models.map((m) => <option value={m}>{m}</option>)}
    </select>
    <label><input type="checkbox" id="g-misses" /> {similarity ? 'Only results below the pass mark' : 'Only results with misses'}</label>
    <a href={href(`/suites/${suite.id}/`)}>Case grid →</a>
  </div>
  {
    suite.cases
      .filter((c) => c.input.image)
      .map((c) => {
        const rs = results.filter((r) => r.case === c.id)
        return (
          <section class="shot-case" id={c.id}>
            {isEdit(c.expected) && c.expected.region ? (
              <div class="shot-wrap">
                <Boxes path={c.input.image!} alt={c.description || c.id} expected={{ boxes: [{ label: 'edit area', box: c.expected.region }] }} />
              </div>
            ) : isRegions(c.expected) ? (
              <div class="shot-wrap">
                <Boxes path={c.input.image!} alt={c.description || c.id} expected={c.expected} />
              </div>
            ) : (
              <Shot path={c.input.image!} alt={c.description || c.id} wrapClass="shot-wrap" />
            )}
            <div class="shot-body">
              <h3>
                <code>{c.id}</code> {c.description && <span class="muted">{c.description}</span>}
              </h3>
              {c.instruction && <p class="instruction">{c.instruction}</p>}
              <p class="expect">
                <span class="muted">Expected:</span>{' '}
                {isEdit(c.expected) || isSimilarity(c.expected)
                  ? describeExpected(c.expected)
                  : isRegions(c.expected)
                  ? c.expected.boxes.length === 0
                    ? `no ${(c.expected.labels ?? []).map((l) => (Array.isArray(l) ? l[0] : l)).join(', ')}`
                    : c.expected.boxes.map((b) => <span class="want">{Array.isArray(b.label) ? b.label.join(' / ') : b.label}</span>)
                  : Array.isArray(c.expected)
                  ? c.expected.map((e) => <span class="want">{Array.isArray(e) ? e.join(' / ') : show(e)}</span>)
                  : show(c.expected)}
                {Array.isArray(c.absent) && c.absent.length > 0 && (
                  <>
                    <br />
                    <span class="muted">Wrong if tagged:</span> {c.absent.map((a) => <span class="want no">{a}</span>)}
                  </>
                )}
              </p>
              {rs.length === 0 && <p class="muted">No results yet.</p>}
              {rs.map((r) => (
                <div class="read" data-model={r.model} data-miss={r.hits?.some((h) => !h.found) || r.wrong?.some((w) => w.found) || r.regions?.some((x) => !x.ok) || r.edit?.answers.some((a) => !a.ok) || r.edit?.preservation?.ok === false || (r.similarity && !r.pass) ? '1' : '0'}>
                  <div class="read-head">
                    <a href={href(`/models/${modelSlug(r.model)}/`)}>{r.model}</a>
                    <span class={`pill ${r.pass ? 'pass' : 'fail'}`}>
                      {r.hits ? `${r.hits.filter((h) => h.found).length}/${r.hits.length}` : r.similarity ? `AP ${r.score.toFixed(2)}` : r.pass ? 'pass' : 'fail'}
                    </span>
                    <span class="muted">{(r.latency_ms / 1000).toFixed(1)} s</span>
                  </div>
                  <Compare result={r} />
                  <details>
                    <summary>Reply</summary>
                    <pre>{r.output || '—'}</pre>
                  </details>
                </div>
              ))}
            </div>
          </section>
        )
      })
  }
  <script>
    const model = document.getElementById('g-model') as HTMLSelectElement
    const misses = document.getElementById('g-misses') as HTMLInputElement
    const apply = () => {
      for (const el of document.querySelectorAll<HTMLElement>('.read')) {
        el.hidden = (!!model.value && el.dataset['model'] !== model.value) || (misses.checked && el.dataset['miss'] !== '1')
      }
      for (const sec of document.querySelectorAll<HTMLElement>('.shot-case')) {
        sec.hidden = ![...sec.querySelectorAll<HTMLElement>('.read')].some((r) => !r.hidden)
      }
    }
    model.addEventListener('change', apply)
    misses.addEventListener('change', apply)
  </script>
</Base>

<style>
  .shot-case {
    display: grid; grid-template-columns: minmax(280px, 1fr) minmax(320px, 1fr); gap: 16px;
    padding: 16px; margin: 16px 0; background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
  }
  :global(.shot-wrap img) { width: 100%; max-height: 70vh; object-fit: contain; border: 1px solid var(--line); border-radius: 6px; position: sticky; top: 64px; }
  .shot-body h3 { margin: 0 0 8px; font-size: 15px; }
  .instruction { margin: 0 0 8px; font-weight: 600; }
  .expect { margin: 0 0 8px; font-size: 13px; line-height: 2; }
  .want { display: inline-block; margin: 0 4px 0 0; padding: 0 8px; border: 1px solid var(--line); border-radius: 999px; line-height: 1.6; }
  .want.no { border-style: dashed; color: var(--muted); }
  .read { padding: 8px 0; border-top: 1px solid var(--line); }
  .read-head { display: flex; gap: 8px; align-items: center; margin-bottom: 4px; }
  details summary { cursor: pointer; color: var(--muted); font-size: 12px; margin-top: 4px; }
  label { color: var(--muted); font-size: 14px; display: flex; gap: 6px; align-items: center; }
  @media (max-width: 760px) { .shot-case { grid-template-columns: 1fr; } }
</style>
