---
import Base from '../layouts/Base.astro'
import { data, fmt, href, modelSlug, pct, qualitySuites, tone } from '../lib/data'

// One leaderboard per machine: a model's latest result on each suite, its
// average pass rate, and its speed and memory at 8K context.
const machines = data.machines.map((m) => {
  const cells = data.cells.filter((c) => c.machine === m.key)
  const models = [...new Set(cells.map((c) => c.model))]
  const rows = models.map((model) => {
    const bySuite = Object.fromEntries(qualitySuites.map((s) => [s.id, cells.find((c) => c.model === model && c.suite === s.id)]))
    const present = Object.values(bySuite).filter((c) => c !== undefined)
    const avg = present.length === 0 ? null : present.reduce((sum, c) => sum + pct(c.passed, c.total), 0) / present.length
    const speed = data.perf.find((p) => p.machine === m.key && p.model === model && p.case === 'ctx-8k')
    return { model, bySuite, avg, covered: present.length, speed }
  })
  rows.sort((a, b) => (b.avg ?? -1) - (a.avg ?? -1))
  return { machine: m, rows }
})
---

<Base
  title="Leaderboard"
  description="Each model's latest result on every suite, per machine. Click a header to sort, a score to see that suite's cases, or a model for its detail."
>
  {
    machines.map(({ machine, rows }) => (
      <section>
        <h2>
          {machine.chip}, {machine.mem_gib} GiB <span class="muted">({machine.key})</span>
        </h2>
        <div class="scroll">
          <table data-table id={`lb-${machine.key}`}>
            <thead>
              <tr>
                <th data-sort="text">Model</th>
                {qualitySuites.map((s) => (
                  <th data-sort="num" class="num">
                    {s.id} <span class="muted">({s.cases.length})</span>
                  </th>
                ))}
                <th data-sort="num" class="num" title="Mean pass rate over the suites the model ran">Average</th>
                <th data-sort="num" class="num" title="Output tokens per second at 8K context">Output tok/s</th>
                <th data-sort="num" class="num" title="Loaded size at 8K context, from Ollama /api/ps">Loaded GB</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td data-value={r.model}>
                    <a href={href(`/models/${modelSlug(r.model)}/`)}>{r.model}</a>
                    {(() => {
                      const m = data.models.find((x) => x.label === r.model)
                      return (
                        <div class="muted" style="font-size:12px">
                          {m?.released && `${m.released}${m.released_approx ? ' (approx)' : ''}`}
                          {m?.baseline && <span class="pill stale" title={m.baseline}> baseline</span>}
                          {m?.retired && <span class="pill fail" title={m.retired}> retired</span>}
                        </div>
                      )
                    })()}
                  </td>
                  {qualitySuites.map((s) => {
                    const c = r.bySuite[s.id]
                    if (!c) return <td class="heat muted" data-value="-1">n/a</td>
                    const rate = pct(c.passed, c.total)
                    return (
                      <td class={`heat ${tone(rate)}`} data-value={rate}>
                        <a href={href(`/results/?suite=${s.id}&model=${encodeURIComponent(r.model)}`)}>{rate}%</a>
                        <small>
                          {c.passed}/{c.total} · {fmt((c.median_ms ?? 0) / 1000)} s{c.stale && ' · stale'}
                          {c.missing.length > 0 && ` · ${c.missing.length} not run`}
                        </small>
                      </td>
                    )
                  })}
                  <td class="num" data-value={r.avg ?? -1}>
                    <strong>{r.avg === null ? '—' : `${Math.round(r.avg)}%`}</strong>
                    <span class="muted"> · {r.covered}/{qualitySuites.length}</span>
                  </td>
                  <td class="num" data-value={r.speed?.decode_tps ?? -1}>{fmt(r.speed?.decode_tps)}</td>
                  <td class="num" data-value={r.speed?.loaded_gb ?? -1}>{fmt(r.speed?.loaded_gb, 2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }
  <p class="note">
    <strong>baseline</strong>: kept past the 12-month age limit because a target app uses it today or it is a category's
    yardstick, not a recommendation. <strong>retired</strong>: older than 12 months and no longer run. Hover either for
    the reason.
  </p>
  <h2>Suites</h2>
  <div class="cards">
    {
      qualitySuites.map((s) => (
        <a class="card" href={href(`/suites/${s.id}/`)}>
          <div class="k">{s.id}</div>
          <div class="v">{s.cases.length} cases</div>
          <div class="muted">fingerprint {s.fingerprint}</div>
        </a>
      ))
    }
  </div>
  <p class="note">
    Average is over the suites a model can run (no tool calls for models without tools, no images for text-only
    models), so compare it alongside the coverage count. Suites have 8–20 cases: a gap of one or two cases is noise.
  </p>
</Base>
