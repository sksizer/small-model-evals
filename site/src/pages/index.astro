---
import Base from '../layouts/Base.astro'
import { data, fmt, fmtParams, fmtTime, href, machineLabel, modelSlug, pct, tone } from '../lib/data'
---

<Base
  title="Leaderboard"
  description="Each suite's models ranked, then every model's latest result per task family, per machine. Click a header to sort, a score to see that suite's cases, or a model for its detail."
>
  {
    data.leaderboard.map(({ machine, families }) => (
      <section data-machine={machine.key}>
        <h2>
          {machineLabel(machine)} <span class="muted">({machine.key})</span>
        </h2>
        <p class="note">
          Class <span class="pill class">{machine.class}</span> · model memory budget {fmt(machine.budget_gib, 1)} GiB. These results are
          from this machine only; other machines are shown separately, never averaged in.
        </p>
        <h3 class="part">Rankings by suite</h3>
        <p class="note">
          Each suite's models by pass rate, then mean score, then speed. Speed is the median case time for a language
          model and the median time per image for an in-process model or an image editor.
        </p>
        {families.map((f) => (
          <>
            <h4 class="family">{f.title} <span class="muted">{f.blurb}</span></h4>
            <div class="ranks">
              {f.ranking.map((r) => (
                <div class="card rank">
                  <a class="k" href={href(`/suites/${r.suite}/`)}>{r.suite}</a>
                  <div class="muted about">{r.about} · {r.cases} cases</div>
                  <table class="mini">
                    <tbody>
                      {r.ranks.map((m, i) => {
                        const rate = pct(m.passed, m.total)
                        return (
                          <tr>
                            <td class="muted pos">{i + 1}</td>
                            <td class="who"><a href={href(`/models/${modelSlug(m.model)}/`)}>{m.model}</a></td>
                            <td class="num">
                              <a href={href(`/results/?suite=${r.suite}&model=${encodeURIComponent(m.model)}`)}>{m.passed}/{m.total}</a>
                            </td>
                            <td class="num"><span class={`pill-heat heat ${tone(rate)}`}>{rate}%</span></td>
                            <td class="num muted" title="Mean score">{fmt(m.mean, 2)}</td>
                            <td class="num muted" title={m.time_per === 'image' ? 'Median time per image' : 'Median time per case'}>{fmtTime(m.time_ms, m.time_per)}</td>
                          </tr>
                        )
                      })}
                    </tbody>
                  </table>
                </div>
              ))}
            </div>
          </>
        ))}

        <h3 class="part">Full matrix</h3>
        <p class="note">One table per task family, listing the models with a result in it. Cells show pass rate, passed/total and the median time.</p>
        {families.map((f) => (
          <>
            <h4 class="family">{f.title}</h4>
            <div class="scroll">
              <table data-table id={`lb-${machine.key}-${f.id}`}>
                <thead>
                  <tr>
                    <th data-sort="text" class="pin">Model</th>
                    <th data-sort="text">Kind</th>
                    <th data-sort="num" class="num" title="Total weights, from the Hugging Face metadata">Params</th>
                    <th data-sort="text">Licence</th>
                    {f.suites.map((s) => (
                      <th data-sort="num" class="num suite-h" title={s.about}>
                        {s.id.split('-').map((part, i) => (i === 0 ? part : <>-<wbr />{part}</>))}
                        <br /><span class="muted">({s.cases})</span>
                      </th>
                    ))}
                    <th data-sort="num" class="num suite-h" title="Mean pass rate over this family's suites the model ran">Average</th>
                    {f.has_speed && <th data-sort="num" class="num suite-h" title="Output tokens per second at 8K context">Output tok/s</th>}
                    {f.has_speed && <th data-sort="num" class="num suite-h" title="Loaded size at 8K context, from Ollama /api/ps">Loaded GB</th>}
                  </tr>
                </thead>
                <tbody>
                  {f.rows.map((r) => (
                    <tr>
                      <td data-value={r.model} class="pin">
                        <a class="model-name" href={href(`/models/${modelSlug(r.model)}/`)}>{r.model}</a>
                        {r.url && <a href={r.url} title="Where to get it" aria-label={`Where to get ${r.model}`}> ↗</a>}
                        <div class="muted" style="font-size:12px">
                          {r.released && `${r.released}${r.released_approx ? ' (approx)' : ''}`}
                          {r.baseline && <span class="pill stale" title={r.baseline}> baseline</span>}
                          {r.retired && <span class="pill fail" title={r.retired}> retired</span>}
                        </div>
                      </td>
                      <td data-value={r.kind ?? ''} style="white-space:nowrap;font-size:12px">{r.kind ?? '—'}</td>
                      <td class="num" data-value={r.parameters ?? -1} title={r.parameters_note ?? undefined} style="white-space:nowrap">{fmtParams(r.parameters)}</td>
                      <td data-value={r.licence ?? ''} style="font-size:12px;min-width:7em">{r.licence ?? '—'}</td>
                      {f.suites.map((s) => {
                        const c = r.cells[s.id]
                        if (!c) return <td class="heat muted" data-value="-1">n/a</td>
                        const rate = pct(c.passed, c.total)
                        return (
                          <td class={`heat ${tone(rate)}`} data-value={rate}>
                            <a href={href(`/results/?suite=${s.id}&model=${encodeURIComponent(r.model)}`)}>{rate}%</a>
                            <small>
                              {c.passed}/{c.total} · {fmtTime(c.time_ms, c.time_per)}{c.stale && ' · stale'}
                              {c.missing.length > 0 && ` · ${c.missing.length} not run`}
                            </small>
                          </td>
                        )
                      })}
                      <td class="num" data-value={r.avg}>
                        <strong>{Math.round(r.avg)}%</strong>
                        <span class="muted"> · {r.covered}/{f.suites.length}</span>
                      </td>
                      {f.has_speed && <td class="num" data-value={r.decode_tps ?? -1}>{fmt(r.decode_tps)}</td>}
                      {f.has_speed && <td class="num" data-value={r.loaded_gb ?? -1}>{fmt(r.loaded_gb, 2)}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ))}
      </section>
    ))
  }
  <p class="note">
    <strong>baseline</strong>: kept past the 12-month age limit because a target app uses it today or it is a category's
    yardstick, not a recommendation. <strong>retired</strong>: older than 12 months and no longer run. Hover either for
    the reason.
  </p>
  <p class="note">
    Average is over the suites a model can run (no tool calls for models without tools, no images for text-only
    models), so compare it alongside the coverage count. Suites have 8–20 cases: a gap of one or two cases is noise.
  </p>
</Base>

<style>
  .model-name { white-space: nowrap; }
  /* Suite and figure headers wrap (suite names at hyphens), so a column is as wide as its values, not its name. */
  .suite-h { white-space: normal; }
  /* The model column stays in view when a narrow window scrolls the table. */
  .pin { position: sticky; left: 0; z-index: 1; background: var(--panel); }
  th.pin { z-index: 2; }
  .part { font-size: 16px; margin: 24px 0 4px; }
  .family { font-size: 14px; margin: 20px 0 6px; }
  .family .muted { font-weight: 400; margin-left: 6px; }
  /* One compact card per suite: the models ranked, a line each. */
  .ranks { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 12px; margin: 8px 0 16px; }
  .rank { padding: 10px 12px; }
  .rank .k { font-size: 13px; font-weight: 650; text-transform: none; color: var(--text); }
  .rank .about { font-size: 12px; margin-bottom: 6px; }
  .mini { font-size: 13px; }
  .mini td { padding: 3px 6px; border-bottom: 0; white-space: nowrap; }
  .mini .pos { width: 1.5em; padding-left: 0; }
  .mini .who { white-space: normal; overflow-wrap: anywhere; }
  .pill-heat { display: inline-block; min-width: 3.2em; padding: 0 6px; border-radius: 999px; text-align: center; }
</style>
