---
// An image that opens full size in a new tab. A sensitive one (nudity; see
// `sensitive` in corpus/sources.yaml) is blurred behind a "Let me view"
// button: it shows only when the viewer clicks, one image at a time, and
// nothing remembers the choice. This is a courtesy, not access control:
// the file itself is served as usual.
import { href, isSensitive } from '../lib/data'

interface Props {
  path: string
  alt: string
  class?: string
  wrapClass?: string
  width?: number
  height?: number
}
const { path, alt, class: imgClass, wrapClass, width, height } = Astro.props
const sensitive = isSensitive(path)
const src = href(`/${path}`)
---

<span class:list={['shot-frame', { censored: sensitive }]}>
  <a class={wrapClass} href={src} target="_blank" rel="noopener" title="Open full size" tabindex={sensitive ? -1 : undefined}>
    <img class={imgClass} src={src} alt={alt} loading="lazy" width={width} height={height} />
  </a>
  {
    sensitive && (
      <button type="button" class="reveal" aria-label={`Let me view ${alt} (contains nudity)`}>
        <span class="reveal-note">Contains nudity</span>
        <span class="reveal-cta">Let me view</span>
      </button>
    )
  }
</span>
