---
// An image that opens full size in a new tab. A sensitive one (nudity, intimate or a child; see
// `sensitive` in corpus/sources.yaml) is covered by a "Let me view" button:
// it shows only when the viewer clicks, one image at a time, and nothing
// remembers the choice.
//
// Fail-safe: a sensitive image's address is not in the page as `src` or
// `href`, only as data attributes that scripts/reveal.ts copies across on the
// click. If the stylesheet or the script fails to load, the viewer sees a
// blank box, never the image. This is a courtesy, not access control: the
// file itself is served as usual.
//
// A slotted overlay (components/Boxes.astro draws region boxes) sits over the
// image and is hidden while the image is covered.
import { href, isSensitive } from '../lib/data'

interface Props {
  path: string
  alt: string
  class?: string
  wrapClass?: string
  width?: number
  height?: number
}
const { path, alt, class: imgClass, wrapClass, width, height } = Astro.props
const sensitive = isSensitive(path)
const src = href(`/${path}`)
---

{
  sensitive ? (
    <span class="shot-frame censored">
      <a class={wrapClass} data-href={src} target="_blank" rel="noopener" title="Open full size">
        <img class={imgClass} data-src={src} alt={alt} width={width} height={height} />
      </a>
      <slot />
      <button type="button" class="reveal" aria-label={`Let me view ${alt} (sensitive image)`}>
        <span class="reveal-note">Sensitive image</span>
        <span class="reveal-cta">Let me view</span>
      </button>
    </span>
  ) : (
    <span class="shot-frame">
      <a class={wrapClass} href={src} target="_blank" rel="noopener" title="Open full size">
        <img class={imgClass} src={src} alt={alt} loading="lazy" width={width} height={height} />
      </a>
      <slot />
    </span>
  )
}
