---
// The visual comparison for one result: chips for expected strings or tags
// (found or missed) plus any wrong tags the model gave; a field table for
// expected fields; or, for a regions result, the model's boxes drawn on the
// image (components/Boxes.astro) with what it found, missed and added, and
// the detector's time and memory; or, for an edit result, the edited image,
// the judge's yes/no on each question, the preservation number and the
// editor's time and memory; or, for a similarity result, its top five
// candidates as thumbnails with the model's score, outlined by how each
// relates to the query (green: copy, edit or scene; amber: same class;
// red: unrelated); or, for a sensitive-suite result, the level it gave against
// the expected one, chips for each category (hit, missed, false alarm) and a
// bar for each risk the model gave. Renders nothing otherwise.
import Boxes from './Boxes.astro'
import Shot from './Shot.astro'
import { show, type Result } from '../lib/data'

interface Props {
  result: Result
  /** Draw a regions result's boxes on the image (off where the page already shows the image). */
  image?: boolean
}
const { result, image = true } = Astro.props
const regions = result.regions
const found = regions?.filter((x) => x.ok).length ?? 0
const expectedN = regions?.filter((x) => x.want).length ?? 0
const missed = regions?.filter((x) => x.want && !x.ok).map((x) => x.label) ?? []
const extra = regions?.filter((x) => !x.want).map((x) => x.label) ?? []
const m = result.metrics ?? {}
const edit = result.edit
const sim = result.similarity
const levels = sim?.detail?.levels
const pc = (x: number) => `${Math.round(x * 100)}%`
const screen = result.screening
// Risks worth drawing: every expected category, and any the model put at 5% or more.
const bars = screen ? (Object.entries(screen.risks) as [string, number][]).filter(([c, r]) => r >= 0.05 || screen.expected.includes(c as never)).sort((a, b) => b[1] - a[1]) : []
// The composite records which stages ran for the image.
const stages = (() => {
  if (!screen) return null
  try {
    const o = JSON.parse(result.output) as { stages?: Record<string, number>; decided_by?: string }
    return o.stages && o.decided_by ? { ms: o.stages, by: o.decided_by } : null
  } catch {
    return null
  }
})()
---

{
  screen && (
    <div class="screen">
      <p class="screen-level">
        <span class={`pill ${screen.outcome === 'exact' ? 'pass' : 'fail'}`}>{screen.predicted_level}</span>
        <span class="muted"> expected </span>
        <b>{screen.expected_level}</b>
        {screen.outcome === 'leak' && <span class="leak"> · {screen.expected_level === 'private' && screen.predicted_level === 'public' ? 'LEAK' : 'under-called'}</span>}
        {screen.outcome === 'false-alarm' && <span class="extra-l"> · false alarm</span>}
      </p>
      <div class="chips">
        {screen.hits.map((c) => <span class="chip found" title="expected and found">{c}</span>)}
        {screen.misses.map((c) => <span class="chip missed" title="expected, not found">{c}</span>)}
        {screen.false_alarms.map((c) => <span class="chip wrong" title="not expected, raised">✗ {c}</span>)}
        {screen.hits.length + screen.misses.length + screen.false_alarms.length === 0 && <span class="muted">no categories, none raised</span>}
      </div>
      <ul class="bars">
        {bars.map(([c, r]) => (
          <li class={screen.expected.includes(c as never) ? 'want' : ''}>
            <span class="bar-name">{c}</span>
            <span class="bar"><i style={`width:${Math.round(r * 100)}%`} class={r >= 0.5 ? 'on' : ''}></i></span>
            <span class="bar-val">{r.toFixed(2)}</span>
          </li>
        ))}
      </ul>
      <p class="muted">
        {m['classify_ms'] !== undefined && `${m['classify_ms'] < 10 ? m['classify_ms'].toFixed(1) : Math.round(m['classify_ms'])} ms per image`}
        {m['rss_mb'] !== undefined && ` · ${Math.round(m['rss_mb'])} MB process memory`}
        {m['loaded_bytes'] !== undefined && ` · ${(m['loaded_bytes'] / 1e9).toFixed(1)} GB loaded`}
        {stages && ` · decided by ${stages.by}; stages ${Object.entries(stages.ms).map(([n, ms]) => `${n} ${ms} ms`).join(', ')}`}
      </p>
    </div>
  )
}

{
  result.hits && (
    <div class="chips">
      {result.hits.map((h) => (
        <span class={`chip ${h.found ? 'found' : 'missed'}`} title={h.found ? 'read' : 'missed'}>
          {h.want}
        </span>
      ))}
      {result.wrong?.filter((w) => w.found).map((w) => (
        <span class="chip wrong" title="a tag that is wrong for this image">✗ {w.want}</span>
      ))}
    </div>
  )
}
{
  regions && (
    <div class="regions">
      <p class="region-sum">
        <b>
          {found}/{expectedN}
        </b>{' '}
        found
        {missed.length > 0 && <span class="missed-l"> · missed {missed.join(', ')}</span>}
        {extra.length > 0 && <span class="extra-l"> · {extra.length} extra ({[...new Set(extra)].join(', ')})</span>}
        {(m['detect_ms'] !== undefined || m['rss_mb'] !== undefined) && (
          <span class="muted">
            {' '}
            · {m['detect_ms'] !== undefined && `${Math.round(m['detect_ms'])} ms per image`}
            {m['rss_mb'] !== undefined && ` · ${Math.round(m['rss_mb'])} MB process memory`}
          </span>
        )}
      </p>
      {image && result.image && <Boxes path={result.image} alt={`${result.model} on ${result.case}`} regions={regions} small />}
    </div>
  )
}
{
  edit && (
    <div class="edit">
      {image && edit.image && <Shot path={edit.image} alt={`${result.model} edit for ${result.case}`} wrapClass="edit-link" class="edit-img" />}
      <ul class="judged">
        {edit.answers.map((a) => (
          <li class={a.ok ? 'ok' : 'bad'}>
            <span class="kind">{a.kind}</span> {a.question}{' '}<b>{a.answer ?? 'no answer'}</b>
          </li>
        ))}
        {edit.preservation && (
          <li class={edit.preservation.ok ? 'ok' : 'bad'}>
            <span class="kind">outside region</span> differs by {edit.preservation.diff.toFixed(1)} of 255 (limit {edit.preservation.max}){' '}
            <b>{edit.preservation.ok ? 'preserved' : 'changed'}</b>
          </li>
        )}
      </ul>
      <p class="muted">
        {edit.judge && `judge ${edit.judge}`}
        {m['edit_ms'] !== undefined && ` · ${(m['edit_ms'] / 1000).toFixed(0)} s per edit`}
        {m['peak_mb'] !== undefined && ` · ${(m['peak_mb'] / 1024).toFixed(1)} GB peak memory`}
      </p>
    </div>
  )
}
{
  sim && (
    <div class="sim">
      <ol class="rank">
        {sim.top.map((t) => (
          <li class={`lv lv-${t.level}`} title={`${t.id}: ${t.level}`}>
            <Shot path={t.path} alt={`${t.id} (${t.level})`} class="rank-img" />
            <span class="lv-name">{t.level}</span>
            <span class="lv-score">{t.score.toFixed(3)}</span>
          </li>
        ))}
      </ol>
      <p class="muted">
        {sim.detail ? `AP ${sim.detail.ap.toFixed(2)}` : 'no ranking'}
        {levels && Object.entries(levels).map(([l, r]) => ` · ${l} @1 ${pc(r.r1)} @5 ${pc(r.r5)}`)}
        {sim.detail && ` · other in top 5 ${pc(sim.detail.other5)}`}
        {m['embed_ms'] !== undefined && ` · ${m['embed_ms'].toFixed(m['embed_ms'] < 10 ? 1 : 0)} ms per image`}
        {m['rss_mb'] !== undefined && ` · ${Math.round(m['rss_mb'])} MB process memory`}
      </p>
    </div>
  )
}
{result.tags && <p class="tags">Tags given: {result.tags.join(', ') || '—'}</p>}
{
  result.fields && (
    <table class="fields">
      <thead>
        <tr>
          <th>Field</th>
          <th>Expected</th>
          <th>Got</th>
        </tr>
      </thead>
      <tbody>
        {result.fields.map((f) => (
          <tr class={f.ok ? 'ok' : 'bad'}>
            <td>
              <code>{f.field}</code>
            </td>
            <td>
              <code>{show(f.want) || 'null'}</code>
            </td>
            <td>
              <code>{show(f.got) || 'null'}</code>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}

<style>
  /* The img is rendered inside Shot, outside this component's scope. */
  :global(.edit-img) { display: block; width: 100%; max-width: 360px; height: auto; max-height: 50vh; object-fit: contain; border: 1px solid var(--line); border-radius: 6px; }
  :global(.rank-img) { display: block; width: 100%; height: 72px; object-fit: cover; border-radius: 3px; }
  .rank { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; margin: 4px 0; padding: 0; }
  .rank li { border: 2px solid var(--line); border-radius: 6px; padding: 2px; font-size: 11px; line-height: 1.3; }
  .rank li.lv-copy, .rank li.lv-edit, .rank li.lv-scene { border-color: var(--good); background: var(--good-bg); }
  .rank li.lv-class { border-color: var(--warn); background: var(--warn-bg); }
  .rank li.lv-other { border-color: var(--bad); background: var(--bad-bg); }
  .lv-name { display: inline-block; font-weight: 600; }
  .lv-score { float: right; color: var(--muted); font-variant-numeric: tabular-nums; }
  .judged { list-style: none; margin: 6px 0; padding: 0; font-size: 13px; }
  .judged li { padding: 2px 8px; border-left: 3px solid transparent; }
  .judged li.ok { border-color: var(--good); }
  .judged li.bad { border-color: var(--bad); background: var(--bad-bg); }
  .judged .kind { color: var(--muted); font-size: 11px; text-transform: uppercase; margin-right: 4px; }
  .screen-level { margin: 4px 0; font-size: 13px; }
  .leak { color: var(--bad); font-weight: 700; }
  .bars { list-style: none; margin: 6px 0 2px; padding: 0; font-size: 12px; }
  .bars li { display: grid; grid-template-columns: 90px 1fr 40px; gap: 6px; align-items: center; line-height: 1.5; }
  .bars li.want .bar-name { font-weight: 700; }
  .bar { display: block; height: 7px; background: var(--line); border-radius: 4px; overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--muted); }
  .bar i.on { background: var(--warn); }
  .bar-val { color: var(--muted); font-variant-numeric: tabular-nums; text-align: right; }
  .region-sum { margin: 4px 0 6px; font-size: 13px; }
  .missed-l { color: var(--muted); }
  .extra-l { color: var(--bad, #d93025); }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; }
  .chip { font-size: 12px; padding: 2px 8px; border-radius: 999px; border: 1px solid transparent; }
  .chip.found { background: var(--good-bg); color: var(--good); }
  .chip.missed { background: var(--bad-bg); color: var(--bad); text-decoration: line-through; }
  .chip.wrong { background: var(--bad); color: var(--panel); font-weight: 600; }
  .tags { margin: 4px 0 0; font-size: 12px; color: var(--muted); }
  .fields { width: auto; margin-top: 4px; }
  .fields th, .fields td { padding: 3px 10px; font-size: 13px; }
  .fields tr.ok td:last-child { color: var(--good); }
  .fields tr.bad td { background: var(--bad-bg); }
  .fields tr.bad td:last-child { color: var(--bad); font-weight: 600; }
</style>
