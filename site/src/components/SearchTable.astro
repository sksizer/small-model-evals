---
// Model by kind for the search suite, from each result's recorded numbers (assertions/search.ts,
// scripts/export-site.ts `searchCells`), in two tables: photos, documents and text; then sounds, speech, videos and clip-to-clip (a sound or
// video as the query). Per kind: nDCG@10 (the score: how high the
// relevant items rank, 1 is perfect), recall@5 (relevant items in the top five, over the most five
// could hold) and the time to embed one item (an image, or a food or note); with the pass count (cases at
// nDCG@10 >= 0.7). EmbeddingGemma 2 also shows its nDCG@10 at 256 dimensions. A model absent from a kind
// cannot take that input (a text-only embedder has no photos column). Restricted licences are marked: the
// licence filter in the model finder reads the same `permissive` flag.
import { data, fmt, fmtTime, href, modelSlug } from '../lib/data'

const KINDS = [
  { id: 'photos', title: 'Photos by text', about: '25 queries over 78 photos, and 65 harder ones over those photos plus their near-duplicate copies' },
  { id: 'docs', title: 'Documents by text', about: '24 queries, and 26 fine-grained ones, over 44 synthetic pages, read as images' },
  { id: 'text', title: 'Text by text', about: '52 food queries over all 7793 USDA foods, and 43 note queries over 88 notes (18 of them harder)' },
  { id: 'sounds', title: 'Sounds by text', about: '38 queries over 59 sound clips (Wikimedia Commons), from the audio alone' },
  { id: 'speech', title: 'Speech by text', about: '24 queries over 20 LibriVox readings of about 100 s each; the clip, not a transcript, is what is searched (a pipeline makes its own)' },
  { id: 'videos', title: 'Videos by text', about: '29 queries over 39 silent 10 s videos, from the pictures alone' },
  { id: 'sound-to-sound', title: 'Sound to sound', about: '16 sound clips as the query over the sounds plus 32 derived copies: copies first, then other sounds of the kind' },
  { id: 'video-to-video', title: 'Video to video', about: '10 video clips as the query over the videos plus 20 derived copies: copies, same-place shots, then other videos of the kind' },
] as const
/** The table of each group: the original kinds, then the audio and video ones. */
const GROUPS = [KINDS.slice(0, 3), KINDS.slice(3)]
const machines = [...new Set(data.search.cells.map((c) => c.machine))]
const finder = new Map(data.finder.rows.map((r) => [`${r.machine}\u0000${r.model}`, r] as const))
const f = (x: number | null) => (x === null ? '—' : x.toFixed(2))
const p = (x: number | null) => (x === null ? '—' : `${Math.round(x * 100)}%`)
const tables = machines.flatMap((machine) => GROUPS.map((group) => ({ machine, group, ...table(machine, group) }))).filter((t) => t.rows.length > 0)
function table(machine: string, group: readonly (typeof KINDS)[number][]) {
  const kinds = new Set<string>(group.map((k) => k.id))
  const mine = data.search.cells.filter((c) => c.machine === machine && kinds.has(c.kind))
  const models = [...new Set(mine.map((c) => c.model))]
  const rows = models
    .map((model) => {
      const cells = Object.fromEntries(mine.filter((c) => c.model === model).map((c) => [c.kind, c] as const))
      const scored = Object.values(cells).flatMap((c) => (c.ndcg10 === null ? [] : [c.ndcg10]))
      const mem = Math.max(...Object.values(cells).map((c) => (c.loaded_gb !== null ? c.loaded_gb : c.mem_mb !== null ? (c.mem_mb * 2 ** 20) / 1e9 : 0)))
      return { model, cells, avg: scored.length === 0 ? 0 : scored.reduce((a, b) => a + b, 0) / scored.length, mem: mem > 0 ? mem : null, info: finder.get(`${machine}\u0000${model}`) }
    })
    .sort((a, b) => b.avg - a.avg)
  return { rows }
}
---

{
  tables.map(({ machine, group, rows }) => (
    <div class="scroll">
      {(machines.length > 1 || tables.length > 1) && <h3>{machines.length > 1 ? `${machine}: ` : ''}{group[0]!.id === 'photos' ? 'Photos, documents and text' : 'Sounds, speech and video'}</h3>}
      <table class="search-table">
        <thead>
          <tr>
            <th rowspan="2">Model</th>
            {group.map((k) => <th colspan="3" class="num lvl" title={k.about}>{k.title}</th>)}
            <th rowspan="2" class="num" title="Largest memory reading while it ran: Ollama's loaded size, or the process's resident memory for an in-process model (an upper bound)">Memory</th>
          </tr>
          <tr>
            {group.map(() => <><th class="num" title="Mean nDCG@10: 1 means every relevant item ranks first">nDCG@10</th><th class="num" title="Relevant items in the top five, over the most five slots could hold">R@5</th><th class="num" title="Mean time to embed one item (a photo or page, or a food or note)">ms/item</th></>)}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td class="pin">
                <a href={href(`/models/${modelSlug(r.model)}/`)}>{r.model}</a>
                {r.info && !r.info.permissive && <span class="restricted" title={`Restricted licence: ${r.info.licence}. Not open for commercial use without terms.`}>{r.info.licence}</span>}
              </td>
              {group.map((k) => {
                const c = r.cells[k.id]
                return c ? (
                  <>
                    <td class="num">
                      <strong>{f(c.ndcg10)}</strong>
                      <small>{c.passed}/{c.total} pass{c.stale ? ' · stale' : ''}</small>
                      {c.ndcg10_256 !== null && <small title="nDCG@10 with the vectors cut to 256 dimensions and re-normalised (Matryoshka)">256-d {f(c.ndcg10_256)}</small>}
                      {c.hard !== null && c.original !== null && <small title={`nDCG@10 over the ${c.total - c.hard_total} original cases and over the ${c.hard_total} harder cases (${c.hard_passed} pass)`}>original {f(c.original)} · hard {f(c.hard)}</small>}
                      {k.id === 'text' && Object.keys(c.by_corpus).length > 1 && <small>foods {f(c.by_corpus['foods'] ?? null)} · notes {f(c.by_corpus['notes'] ?? null)}</small>}
                    </td>
                    <td class="num">{p(c.r5)}</td>
                    <td class="num">{fmtTime(c.time_ms, c.time_per)}</td>
                  </>
                ) : (
                  <td colspan="3" class="num muted" title="This model does not take this input">—</td>
                )
              })}
              <td class="num">{r.mem === null ? '—' : `${fmt(r.mem, 1)} GB`}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))
}

<style>
  .search-table th.lvl { text-align: center; border-left: 1px solid var(--line); }
  .search-table td small { display: block; color: var(--muted); font-size: 11px; line-height: 1.3; white-space: nowrap; }
  .search-table td:nth-child(3n+2) { border-left: 1px solid var(--line); }
  .restricted { display: block; width: fit-content; margin-top: 2px; padding: 0 6px; border-radius: 999px; background: var(--warn-bg); color: var(--warn); font-size: 11px; }
</style>
